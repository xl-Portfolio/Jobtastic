@{
    ViewData["Title"] = "Meine Inserate";
}
@model List<JobPosting>

<h1>@ViewData["Title"]</h1>
<a id="postJobBtn" class="btn btn-primary mb-3" asp-area="" asp-controller="Posting" asp-action="Form" asp-route-id="0"
   data-has-mandate="@ViewBag.HasMandate.ToString().ToLower()"
   data-mandate-url="@Url.Page("/Account/Manage/CompanyMandate", new { area = "Identity" })">
    Jobangebot posten
</a>
@* Exists only to carry the antiforgery token for the fetch call in postingDelete.js. *@
<form id="postingActionForm">@Html.AntiForgeryToken()</form>

@if (Model == null || !Model.Any())
{
    <p>Sie haben noch kein Inserat gepostet.</p>
}
else
{
    <table id="allPostings" class="table table-striped align-top" style="width:100%">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Firma</th>
                <th>Ort</th>
                <th>Jahresgehalt</th>
                <th>Startdatum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (JobPosting job in Model)
            {
                <tr data-id="@job.ID" data-title="@job.JobTitle">
                    <td>
                        <a asp-area="" asp-controller="Home" asp-action="JobDetails" asp-route-id="@job.ID">
                            @job.JobTitle
                        </a>
                    </td>
                    <td>
                        @job.Company.Name
                        @if (!string.IsNullOrWhiteSpace(job.Company.WebsiteURL))
                        {
                            <a href="@job.Company.WebsiteURL" target="_blank" rel="noopener noreferrer" title="Link zu Firmenwebsite">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        }
                    </td>
                    <td>@job.JobLocation</td>
                    <td>@job.AnnualSalary.ToString("C")</td>
                    <td>@job.StartDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="btn btn-sm @(job.IsOnline ? "btn-success" : "btn-outline-secondary")" style="cursor: default; pointer-events: none;">
                                @(job.IsOnline ? "online" : "offline")
                            </span>
                            <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Posting" asp-action="Form" asp-route-id="@job.ID" title="Posting bearbeiten">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm deletePostingBtn" data-id="@job.ID" title="Posting löschen">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-dt/css/dataTables.dataTables.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-dt/js/dataTables.dataTables.min.js"></script>
    <script src="~/js/postingIndexGuard.js"></script>
    <script>
            new DataTable('#allPostings', {
                columnDefs: [
                    { orderable: true, searchable: true, targets: -1 }
                ]
            });
    </script>
    @* Loaded after the DataTable exists, so the delete handler can reach its API. *@
    <script src="~/js/postingDelete.js"></script>
}