@using Jobtastic.Authorization
@{
    ViewData["Title"] = "Benutzerverwaltung";
    ViewData["AdminPage"] = "Users";
    var callerId = ViewBag.CurrentUserId as string;
}
@model List<AdminUserListModel>

<h1>@ViewData["Title"]</h1>
<partial name="_AdminNav" />
<p class="text-muted">@Model.Count Konten</p>
@* Exists only to carry the antiforgery token for the fetch calls in adminUsers.js. *@
<form id="adminActionForm">@Html.AntiForgeryToken()</form>

<table id="allUsers" class="table table-striped align-top" style="width:100%">
    <thead>
        <tr>
            <th>E-Mail</th>
            <th>Rolle</th>
            <th>Status</th>
            <th>Registriert</th>
            <th>Mandate</th>
            <th>Kontakte</th>
            <th>Anzeigen</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (AdminUserListModel user in Model)
        {
            <tr id="userRow_@user.Id" data-user-id="@user.Id" data-email="@user.Email">
                <td>@user.Email</td>
                @* Roles are stored additively; only the highest one is shown, so each
                   account reads as having exactly one role. *@
                <td data-role="roles">
                    <span class="badge @(user.IsOwner ? "text-bg-dark" : user.IsAdmin ? "text-bg-primary" : "text-bg-secondary")">
                        @user.EffectiveRole
                    </span>
                </td>
                <td data-role="status">
                    @if (user.IsLocked)
                    {
                        <span class="badge text-bg-danger">gesperrt</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">aktiv</span>
                    }
                </td>
                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (user.MandateCount > 0)
                    {
                        <a asp-area="Identity" asp-page="/Account/Manage/CompanyMandate" asp-route-userId="@user.Id"
                           title="Mandate dieses Kontos anzeigen">@user.MandateCount</a>
                    }
                    else
                    {
                        @user.MandateCount
                    }
                </td>
                <td>
                    @if (user.ContactCount > 0)
                    {
                        <a asp-controller="Admin" asp-action="Contacts" asp-route-owner="@user.Email"
                           title="Kontakte dieses Kontos anzeigen">@user.ContactCount</a>
                    }
                    else
                    {
                        @user.ContactCount
                    }
                </td>
                <td>
                    @if (user.PostingCount > 0)
                    {
                        <a asp-controller="Admin" asp-action="Postings" asp-route-owner="@user.Email"
                           title="Anzeigen dieses Kontos anzeigen">@user.PostingCount</a>
                    }
                    else
                    {
                        @user.PostingCount
                    }
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Identity" asp-page="/Account/Manage/CompanyMandate" asp-route-userId="@user.Id"
                           title="Mandate dieses Kontos verwalten">
                            <i class="bi bi-building"></i>
                        </a>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Identity" asp-page="/Account/Manage/ManagedContacts" asp-route-userId="@user.Id"
                           title="Kontakte dieses Kontos verwalten">
                            <i class="bi bi-person-lines-fill"></i>
                        </a>
                        @* The same rules the server enforces decide whether the button
                           is offered at all, so UI and server cannot disagree. *@
                        @if (AccountAccess.MayRevokeAdmin(callerId, user.Id, user.IsOwner) || !user.IsAdmin)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm roleToggleBtn"
                                    data-is-admin="@user.IsAdmin.ToString().ToLower()"
                                    title="Admin-Rolle vergeben oder entziehen">
                                <i class="bi bi-shield"></i>
                            </button>
                        }
                        @if (AccountAccess.MayLock(callerId, user.Id, user.IsOwner))
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm lockToggleBtn"
                                    data-locked="@user.IsLocked.ToString().ToLower()"
                                    title="Konto sperren oder entsperren">
                                <i class="bi bi-lock"></i>
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-dt/css/dataTables.dataTables.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-dt/js/dataTables.dataTables.min.js"></script>
    <script>
        new DataTable('#allUsers', {
            columnDefs: [
                { orderable: false, searchable: false, targets: -1 }
            ]
        });
    </script>
    <script src="~/js/adminUsers.js"></script>
}
