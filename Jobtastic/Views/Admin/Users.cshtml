@{
    ViewData["Title"] = "Benutzerverwaltung";
}
@model List<AdminUserListModel>

<h1>@ViewData["Title"]</h1>
<p class="text-muted">@Model.Count Konten</p>

<table id="allUsers" class="table table-striped align-top" style="width:100%">
    <thead>
        <tr>
            <th>E-Mail</th>
            <th>Rollen</th>
            <th>Status</th>
            <th>Registriert</th>
            <th>Mandate</th>
            <th>Kontakte</th>
            <th>Anzeigen</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (AdminUserListModel user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge @(role == "Admin" ? "text-bg-primary" : "text-bg-secondary")">@role</span>
                    }
                </td>
                <td>
                    @if (user.IsLocked)
                    {
                        <span class="badge text-bg-danger">gesperrt</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">aktiv</span>
                    }
                </td>
                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>@user.MandateCount</td>
                <td>@user.ContactCount</td>
                <td>@user.PostingCount</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Identity" asp-page="/Account/Manage/CompanyMandate" asp-route-userId="@user.Id"
                           title="Mandate dieses Kontos verwalten">
                            <i class="bi bi-building"></i>
                        </a>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-area="Identity" asp-page="/Account/Manage/ManagedContacts" asp-route-userId="@user.Id"
                           title="Kontakte dieses Kontos verwalten">
                            <i class="bi bi-person-lines-fill"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-dt/css/dataTables.dataTables.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-dt/js/dataTables.dataTables.min.js"></script>
    <script>
        new DataTable('#allUsers', {
            columnDefs: [
                { orderable: false, searchable: false, targets: -1 }
            ]
        });
    </script>
}
