@model ErrorViewModel
@{
    ViewData["Title"] = "Fehler";
}

<h1 class="text-danger">Ein Fehler ist aufgetreten.</h1>
<p>Bei der Verarbeitung deiner Anfrage ist ein Fehler aufgetreten.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request-ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Entwicklungsmodus</h3>
<p>
    In der Umgebung <strong>Development</strong> werden ausführlichere Details zum Fehler angezeigt.
</p>
<p>
    <strong>Die Development-Umgebung sollte für bereitgestellte Anwendungen nicht aktiviert sein.</strong>
    Sie kann dazu führen, dass Endnutzern sensible Informationen aus Exceptions angezeigt werden.
    Zum lokalen Debuggen die Umgebungsvariable <strong>ASPNETCORE_ENVIRONMENT</strong> auf
    <strong>Development</strong> setzen und die App neu starten.
</p>
