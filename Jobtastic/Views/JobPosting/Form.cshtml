<!--CreateEditJob Formular-->
@{
    ViewData["Title"] = "Job inserieren";
}
@model JobPosting

 <form asp-controller="JobPosting" asp-action="CreateEditJob" method="post" enctype="multipart/form-data">
    
     <div class="list-group">

        <input class="form-control" hidden  asp-for="ID"/>

        <select class="form-control" asp-for="CompanyID" required asp-items="@(new SelectList(ViewBag.Mandates, "Id", "Name"))">
            <option value="">Firma (bitte wählen)</option>
        </select>
        <input class="form-control" asp-for="JobTitle" required placeholder="Stellenbezeichnung"/>
        <select class="form-control" asp-for="Experience" required asp-items="Html.GetEnumSelectList<Experience>()">
            <option value="">Berufserfahrung (bitte wählen)</option>
        </select>

        <label asp-for="StartDate">Startdatum</label>
        <input class="form-control" asp-for="StartDate" type="date" />
        <hr/>
        <input class="form-control" asp-for="Header" required placeholder="Betiteln Sie Ihr Jobangebot" />
        <input class="form-control" asp-for="JobDescription" required placeholder="Beschreiben Sie den Job ausführlicher"/>
        <hr/>
        <input class="form-control" asp-for="JobLocation" required placeholder="Stadt" />
        <input class="form-control" asp-for="AnnualSalary" required placeholder="Jahresgehalt" />

        <div class="list-group">
            <label>Vollzeit?</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Fulltime" value="True" id="FulltimeYes" />
                <label class="form-check-label" for="FulltimeYes">Ja</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Fulltime" value="False" id="FulltimeNo" />
                <label class="form-check-label" for="FulltimeNo">Nein</label>
            </div>
        </div>

        <input id="VolumeHours" class="form-control" asp-for="VolumeHours" placeholder="Wochenstunden" />
        <select class="form-control" asp-for="Mode" required asp-items="Html.GetEnumSelectList<Mode>()">
            <option value="">Präsenzmodus (bitte wählen)</option>
        </select>

        <div class="list-group">
            <label>Anzeige aktivieren?</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="IsOnline" value="True" id="IsOnlineYes" />
                <label class="form-check-label" for="IsOnlineYes">Ja</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="IsOnline" value="False" id="IsOnlineNo" />
                <label class="form-check-label" for="IsOnlineNo">Nein</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Speichern</button>
       @*  <input type="file" class="form-control" id="Logo" name="file" />  ...muss erst included werden in controller aus companies-table  *@  
</form> 
@section Scripts {
    <script src="~/js/manageJobPostingForm.js"></script>
}