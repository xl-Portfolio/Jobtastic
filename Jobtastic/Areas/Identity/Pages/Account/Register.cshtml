@page
@model RegisterModel
@{
    ViewData["Title"] = "Neu bei Jobtastic?";
    Layout = "_AuthLayout";
}

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating password-field mb-3">
        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.Password">Passwort</label>
        <span class="bi bi-eye-slash eyeIcon"></span>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-floating password-field mb-3">
        <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.ConfirmPassword">Passwort bestätigen</label>
        <span class="bi bi-eye-slash eyeIcon"></span>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Registrieren</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passwordVisibility.js"></script>
}
