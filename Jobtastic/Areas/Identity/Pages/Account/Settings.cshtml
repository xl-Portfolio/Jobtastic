<!--Account Settings User // hier vlt mit Javascript änderungen dynamisch ermöglichen?-->

@{
    ViewData["Title"] = "Account Einstellungen";
}
@model User

<@*form asp-controller="JobPosting" asp-area="Identity" asp-action="EditAccount" method="post" enctype="multipart/form-data">*@
<h2>Account Einstellungen</h2>

<h4>User</h4>    
<div class="list-group">
    <input class="form-control" hidden asp-for="Id"/>
    <label>Username: @Model.UserName</label>
    <label>Email: @Model.Email</label>
    <label>Tel: @(string.IsNullOrEmpty(Model.PhoneNumber) ? "" : Model.PhoneNumber)</label>
</div>

<h4>Mandat Firma</h4>
@if (Model.Company == null)
{
    <label>kein Mandat hinterlegt</label>
}
else
{
    if (!string.IsNullOrEmpty(Model.Company.LogoImageSource))
    {<img src="@Model.Company.LogoImageSource" alt="Logo" />}
    <div class="list-group">
        <input class="form-control" hidden asp-for="@Model.CompanyID" />
        <label>Firmenname: @Model.Company.Name</label>
        <label>Beschreibung: @Model.Company.Description</label>
        <label>Webseite: <a href="@Model.Company.WebsiteURL">@Model.Company.WebsiteURL</a></label>
        <label>Beschäftigte: @Model.Company.NumberEmployees</label>
    </div>
}

<h4>Assoziierte Kontakte</h4>
    <div class="list-group">
    @foreach (JobContact contact in Model.Contacts)
    {
        if (!string.IsNullOrEmpty(contact.ProfileImagePath))
        {
            <img src="contact.ProfileImagePath" alt="Profilbild" />
        }
        <input class="form-control" hidden asp-for="@contact.ID"/>
        <h5>@contact.FirstName @contact.LastName</h5>
        <label>Email: @contact.Email</label>
        <label>Tel: @contact.Phone</label>
        <label>Abteilung: @contact.Department</label>
    }
    </div>
@*</form>*@

    
