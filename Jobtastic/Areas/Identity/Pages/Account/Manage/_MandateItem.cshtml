@model Jobtastic.Models.Company

<div id="mandateItem_@Model.ID" class="mandate-item list-group-item" data-id="@Model.ID">
    <div id="displayMandate_@Model.ID" class="mandateDisplay">
        <div class="d-flex align-items-center">
            @if (!string.IsNullOrEmpty(Model.LogoImageSource))
            {
                <div class="me-3">
                    <img src="@Model.LogoImageSource" alt="Logo" height="60" width="60" />
                </div>
            }
            <div class="flex-grow-1">
                <label style="font-weight: bold; font-size: 1.3em;">
                    @if (!string.IsNullOrEmpty(Model.WebsiteURL))
                    {
                        <a href="@Model.WebsiteURL" target="_blank" rel="noopener">@Model.Name</a>
                    }
                    else
                    {
                        @Model.Name
                    }
                </label>
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm editMandateBtn" data-id="@Model.ID">
                <i class="bi bi-pencil"></i>
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm deleteMandateBtn" data-id="@Model.ID">
                <i class="bi bi-trash"></i>
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="mt-3 pt-2 border-top">@Model.Description</div>
        }
    </div>

    <form class="editMandateForm d-none mt-2" id="editMandateForm_@Model.ID" data-id="@Model.ID">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CompanyId" value="@Model.ID" />
        <input type="hidden" name="ForceCreate" value="false" />
        <div class="row g-2">
            <div class="col-md-12 form-floating">
                <input class="form-control" name="Input.Name" value="@Model.Name" placeholder="Firmenname" required/>
                <label>Firmenname</label>
            </div>
            <div class="col-md-6 form-floating">
                <input class="form-control" type="url" name="Input.LogoImageSource" value="@Model.LogoImageSource" placeholder="Logo (https://bsp.de/logo.png)" />
                <label>Logo (https://bsp.de/logo.png)</label>
            </div>
            <div class="col-md-6 form-floating">
                <input class="form-control" type="url" name="Input.WebsiteURL" value="@Model.WebsiteURL" placeholder="Webseite (https://bsp.de)" />
                <label>Webseite (https://bsp.de)</label>
            </div>
            <div class="col-md-12 form-floating">
                <input class="form-control" name="Input.Description" value="@Model.Description" placeholder="Beschreibung" />
                <label>Beschreibung</label>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-primary btn-sm">Änderungen speichern</button>
                <button type="button" class="btn btn-secondary btn-sm cancelEditBtn" data-id="@Model.ID">Abbrechen</button>
            </div>
        </div>
    </form>
    <form class="deleteMandateForm d-none" id="deleteMandateForm_@Model.ID">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CompanyId" value="@Model.ID" />
    </form>
    <hr />
</div>