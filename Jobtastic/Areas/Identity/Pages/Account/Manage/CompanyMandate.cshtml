@page
@model Jobtastic.Areas.Identity.Pages.Account.Manage.CompanyMandateModel
@{
    ViewData["Title"] = "Meine Mandate";
    ViewData["ActivePage"] = ManageNavPages.CompanyMandate;
}
<div class="row">
    <div class="col-12 text-left">
        <button id="createMandateBtn" type="button" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Mandat hinzufügen
        </button>
    </div>
</div>
<hr />
<form id="addMandateForm" method="post" asp-page-handler="AddMandate" class="mx-auto mt-3" style="max-width: 800px;">
    <div id="addMandate" class="row g-3 d-none">
        <div class="col-md-12 position-relative">
            <input class="form-control" asp-for="Input.Name" placeholder="Firmenname" required autocomplete="off" />
            <input type="hidden" id="existingCompanyId" name="ExistingCompanyId" value="" />
            <input type="hidden" id="forceCreate" name="ForceCreate" value="false" />
            <div id="companySuggestions" class="list-group position-absolute w-100 d-none" style="z-index: 1050; max-height: 220px; overflow-y: auto;"></div>
            <div id="existingCompanyNotice" class="form-text text-info d-none mt-1">
                Firma existiert bereits. Mandat hinzugefügt.
                <a href="#" id="resetExistingCompany">Neue Firma anlegen</a>
            </div>
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.LogoImageSource" placeholder="Logo (https://bsp.de/logo.png)" />
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.WebsiteURL" placeholder="Webseite (https://bsp.de)" />
        </div>
        <div class="col-md-12">
            <input class="form-control" asp-for="Input.Description" placeholder="Beschreibung" />
        </div>
        <div class="col-12">
            <button id="addMandateBtn" type="submit" class="btn btn-primary mt-3">Mandat Speichern</button>
        </div>
    </div>
</form>
<div id="mandatesList" class="list-group mt-3">
    @if (!Model.Companies.Any())
    {
        <label id="noMandatesLabel">kein Mandat hinterlegt</label>
    }
    else
    {
        foreach (var company in Model.Companies)
        {
            @await Html.PartialAsync("_MandateItem", company)
        }
    }
</div>
@section Scripts {
    <script src="~/js/manageMandates.js"></script>
}