@page
@model Jobtastic.Areas.Identity.Pages.Account.Manage.CompanyMandateModel
@{
    ViewData["Title"] = "Meine Mandate";
    ViewData["ActivePage"] = ManageNavPages.CompanyMandate;
}


<div class="row">
    <div class="col-12 text-left">
        <button id="createMandateBtn" type="button" class="btn btn-primary">Mandat hinzufügen</button>
    </div>
</div>
<hr/>

<form method="post" asp-page-handler="AddMandate" class="mx-auto mt-3" style="max-width: 800px;">
    <div id="addMandate" class="row g-3 d-none">
        <div class="col-md-12">
            <input class="form-control" asp-for="Input.Name" placeholder="Firmenname" />
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.LogoImageSource" placeholder="Logo (URL)" />
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.WebsiteURL" placeholder="Webseite" />
        </div>
        <div class="col-md-12">
            <input class="form-control" asp-for="Input.Description" placeholder="Beschreibung" />
        </div>
        <div class="col-12">
            <button id="addMandateBtn" type="submit" class="btn btn-primary mt-3">Mandat Speichern</button>
        </div>
    </div>
</form>


@if (!Model.Companies.Any())
{
    <label>kein Mandat hinterlegt</label>
}
else
{
    foreach (var company in Model.Companies)
    {
        <form method="post" asp-page-handler="EditMandate">
            <div id="displayMandates_@company.ID" class="list-group mandateDisplay">
                <div class="d-flex align-items-center">

                    @if (!string.IsNullOrEmpty(company.LogoImageSource))
                    {
                        <div class="me-3">
                            <img src="@company.LogoImageSource" alt="Logo" height="120" width="120" />
                        </div>
                    }
                    <div class="flex-grow-1">
                        <label style="font-weight: bold; font-size: 1.3em;">
                            <a href="@company.WebsiteURL">@company.Name</a>
                        </label>
                    </div>
                    <button id="editMandateBtn_@company.ID" type="button" class="btn btn-primary editMandateBtn">Bearbeiten</button>
                </div>
                <div class="mt-3 pt-2 border-top">@company.Description</div>
            </div>

            <div id="editMandate_@company.ID" class="list-group d-none mandateForm">
                <!--inline editing-->
                <input class="form-control" asp-for="CompanyId" value="@company.ID" type="hidden"/>
                <input class="form-control" asp-for="Input.Name" value="@company.Name" placeholder="@company.Name" />
                <input class="form-control" asp-for="Input.LogoImageSource" value="@company.LogoImageSource" placeholder="@(company.LogoImageSource ?? "Logo (URL)")" />
                <input class="form-control" asp-for="Input.WebsiteURL" value="@company.WebsiteURL" placeholder="@(company.WebsiteURL ?? "Webseite")" />
                <input class="form-control" asp-for="Input.Description" value="@company.Description" placeholder="@(company.Description ?? "Beschreibung")" />
                <button id="saveMandateChangesBtn_@company.ID" type="submit" class="btn btn-primary saveMandateChangesBtn">Änderungen speichern</button>
            </div>
            <hr/>
        </form>
    }
}
@section Scripts {
    <script src="~/js/manageMandates.js"></script>
}