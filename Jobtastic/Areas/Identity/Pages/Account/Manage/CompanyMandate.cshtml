@page
@model Jobtastic.Areas.Identity.Pages.Account.Manage.CompanyMandateModel
@{
    ViewData["Title"] = "Meine Mandate";
    ViewData["ActivePage"] = ManageNavPages.CompanyMandate;
}
<div class="row">
    <div class="col-12 text-left">
        <button id="createMandateBtn" type="button" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Mandat hinzufügen
        </button>
    </div>
</div>
<hr />
<form id="addMandateForm" method="post" asp-page-handler="AddMandate" class="mx-auto mt-3" style="max-width: 800px;">
    <div id="addMandate" class="row g-3 d-none">
        <div class="col-md-12">
            <input class="form-control" asp-for="Input.Name" placeholder="Firmenname" />
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.LogoImageSource" placeholder="Logo (URL)" />
        </div>
        <div class="col-md-6">
            <input class="form-control" asp-for="Input.WebsiteURL" placeholder="Webseite" />
        </div>
        <div class="col-md-12">
            <input class="form-control" asp-for="Input.Description" placeholder="Beschreibung" />
        </div>
        <div class="col-12">
            <button id="addMandateBtn" type="submit" class="btn btn-primary mt-3">Mandat Speichern</button>
        </div>
    </div>
</form>
<div id="mandatesList" class="list-group mt-3">
    @if (!Model.Companies.Any())
    {
        <label id="noMandatesLabel">kein Mandat hinterlegt</label>
    }
    else
    {
        foreach (var company in Model.Companies)
        {
            @await Html.PartialAsync("_MandateItem", company)
        }
    }
</div>
@section Scripts {
    <script src="~/js/manageMandates.js"></script>
}