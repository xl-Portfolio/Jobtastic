@page
@model IndexModel
@{
    ViewData["Title"] = "Mein Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}


@if (User.IsInRole("Admin"))
{
    <h3>Hallo Admin</h3>
} 

<h5>@ViewData["Title"]</h5>
<form method="post" asp-page-handler="EditData">
<div class="list-group">
    <label>Email: @Model.Input.Email</label>
    <input class="form-control d-none" asp-for="Input.Email" /> <!--inline editing-->
    <label>Tel: @(Model.Input.PhoneNumber ?? "")</label>
    <input class="form-control d-none" asp-for="Input.PhoneNumber"/>
    <button type="submit" class="btn btn-primary">bearbeiten</button>
</div>
</form>
<form method="post" asp-page-handler="EditPassword">
    <div class="list-group">
        <input class="form-control d-none" asp-for="PasswordInput.Password"/>
        <input class="form-control d-none" asp-for="PasswordInput.NewPassword" />
        <input class="form-control d-none" asp-for="PasswordInput.ConfirmedPassword" />
        <button type="submit" class="btn btn-primary">Passwort ändern</button>
    </div>
</form>

