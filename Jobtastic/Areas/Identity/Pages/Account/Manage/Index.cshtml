@page
@model IndexModel
@{
    ViewData["Title"] = $"Profil von {Model.DisplayUserName}";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@if (Model.TargetUserRoles.Contains("Admin"))
{
    <p class="mb-3"><span class="badge text-bg-primary">Admin</span></p>
}

<form method="post" asp-page-handler="EditData" asp-route-userId="@Model.TargetUserIdForLinks" class="mx-auto" style="max-width: 800px;">
    <div id="displayData" class="d-flex justify-content-between align-items-center">
        <div>
            <label class="d-block">Email: @Model.Input.Email</label>
            <label class="d-block">Tel: @(Model.Input.PhoneNumber ?? "")</label>
        </div>
        <button id="editDataBtn" type="button" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil"></i>
        </button>
    </div>
    <div id="editData" class="list-group d-none">
        <input class="form-control" asp-for="Input.Email" placeholder="@Model.Input.Email" />
        <div class="form-floating mb-3">
            <input class="form-control" asp-for="Input.PhoneNumber" placeholder="Telefonnummer hinzufügen" />
            <label asp-for="Input.PhoneNumber">Telefonnummer hinzufügen</label>
        </div>
        <div class="mt-2">
            <button id="saveDataBtn" type="submit" class="btn btn-primary btn-sm">Änderungen speichern</button>
            <button id="cancelDataBtn" type="button" class="btn btn-secondary btn-sm">Abbrechen</button>
        </div>
    </div>
</form>
<hr />
@if (Model.IsActingOnBehalfOfOther)
{
    <p class="text-muted mx-auto" style="max-width: 800px;">
        <i class="bi bi-info-circle"></i>
        Eine Passwortänderung setzt das aktuelle Passwort voraus und ist daher nur
        durch den Kontoinhaber selbst möglich.
    </p>
}
else
{
<form method="post" asp-page-handler="EditPassword" class="mx-auto" style="max-width: 800px;">
    <button id="editPasswordBtn" type="button" class="btn btn-primary">Passwort ändern</button>
    <div id="editPassword" class="list-group d-none">
        <div class="password-field form-floating mb-3">
            <input id="passwordInput" type="password" class="form-control" asp-for="PasswordInput.Password" placeholder="altes Passwort" />
            <label asp-for="PasswordInput.Password">altes Passwort</label>
            <span id="visibilityIcon_Old" class="bi bi-eye-slash eyeIcon"></span>
        </div>
        <div class="password-field form-floating mb-3">
            <input id="newPasswordInput" type="password" class="form-control" asp-for="PasswordInput.NewPassword" placeholder="neues Passwort"/>
            <label asp-for="PasswordInput.NewPassword">neues Passwort</label>
            <span id="visibilityIcon_New" class="bi bi-eye-slash eyeIcon" ></span>
        </div>
        <div class="password-field form-floating mb-3">
            <input id="confirmPasswordInput" type="password" class="form-control" asp-for="PasswordInput.ConfirmedPassword" placeholder="Passwort wiederholen"/>
            <label asp-for="PasswordInput.ConfirmedPassword">Passwort wiederholen</label>
            <span id="visibilityIcon_Confirm" class="bi bi-eye-slash eyeIcon" ></span>
        </div>
        <div class="mt-2">
            <button id="savePasswordBtn" type="submit" class="btn btn-primary btn-sm">Änderungen speichern</button>
            <button id="cancelPasswordBtn" type="button" class="btn btn-secondary btn-sm">Abbrechen</button>
        </div>
    </div>
</form>
}

@section Scripts {
    <script src="~/js/manageAccountIndex.js"></script>
}