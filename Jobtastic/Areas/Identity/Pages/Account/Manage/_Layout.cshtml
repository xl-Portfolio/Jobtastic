@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }

    var adminAwarePage = ViewContext.ViewData.Model as AdminAwarePageModel;
    var profileName = adminAwarePage?.DisplayUserName ?? User.Identity?.Name;
}

<h1>Profil von @profileName</h1>

@if (adminAwarePage?.IsActingOnBehalfOfOther == true)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-shield-exclamation"></i>
            Du bearbeitest gerade das Konto eines anderen Benutzers (ID: @adminAwarePage.TargetUserId) als Admin.
        </span>
        <a class="btn btn-outline-secondary btn-sm text-nowrap ms-3"
           asp-area="" asp-controller="Admin" asp-action="Users">
            <i class="bi bi-arrow-left"></i> Benutzerverwaltung
        </a>
    </div>
}

<div>
    <hr />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
